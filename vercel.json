{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "server/public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "^/assets/(.*)", "dest": "/assets/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "^/(?!api)(.*)", "dest": "/api/app" },
    { "handle": "filesystem" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}